{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "incremental": true,
    "module": "esnext",
    "esModuleInterop": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@nexus/database": [
        "../../packages/database/src/index.ts",
        "../../packages/database/index.ts"
      ],
      "@nexus/database/*": [
        "../../packages/database/src/*",
        "../../packages/database/*"
      ],
      "@nexus/ai-engine": [
        "../../packages/ai-engine/src/index.ts",
        "../../packages/ai-engine/index.ts"
      ],
      "@nexus/ai-engine/*": [
        "../../packages/ai-engine/src/*",
        "../../packages/ai-engine/*"
      ],
      "@nexus-core/growth": [
        "../../packages/growth/src/index.ts",
        "../../packages/growth/index.ts"
      ],
      "@nexus-core/growth/*": [
        "../../packages/growth/src/*",
        "../../packages/growth/*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules"
  ]
}